    products.append(new_id)
    inventory_records.append([new_id, name, float(price), int(stock), exp])
    print("\n[OK] Product added!")
    time.sleep(0.6)
    return True


def handle_stock_transaction(is_restock):
    action_name = "RESTOCK" if is_restock else "SALE"
    
    while True:
        display_stock_guide(action_name)
        
        # 1. ID Loop
        pid = None
        while True:
            raw_id = input("ID: ").strip()
            if raw_id == '0':
                return
            try:
                pid = int(raw_id)
                record_found = next((r for r in inventory_records if r[0] == pid), None)
                if not record_found:
                    print(f"\n[ERROR] ID {pid} not found! Please try again.")
                    continue
                break
            except ValueError:
                print("\n[ERROR] Invalid input! Numeric value required for ID. Try again.")

        # 2. Quantity Loop
        while True:
            raw_qty = input("Quantity: ").strip()
            if raw_qty == '0':
                break
            try:
                qty = int(raw_qty)
                if qty <= 0:
                    print("\n[ERROR] Quantity must be greater than zero. Try again.")
                    continue
                
                # Check stock availability for sale
                if not is_restock and qty > record_found[3]:
                    print(f"\n[ERROR] Not enough stock! Current stock for {record_found[1]} is {record_found[3]}. Try a lower quantity.")
                    continue
                
                # Execute update
                record_found[3] += qty if is_restock else -qty
                total = round(qty * record_found[2], 2)
                
                if is_restock:
                    print(f"\n[OK] Restocked {qty} of {record_found[1]} | Total: PHP {total:.2f}")
                else:
                    print(f"\n[OK] Sold {qty} of {record_found[1]} | Total: PHP {total:.2f}")
                
                time.sleep(0.8)
                break
            except ValueError:
                print("\n[ERROR] Invalid input! Numeric value required for Quantity. Try again.")
        
        if raw_qty == '0':
            continue


def display_inventory_report():
    print("\n--- INVENTORY REPORT ---")
    print(f"{'ID':<8} {'NAME':<22} {'PRICE':<8} {'STOCK':<8} {'EXPIRATION':<15}")
    for r in inventory_records:
        days = (datetime.strptime(r[4], "%Y-%m-%d").date() - date.today()).days
        status = "[EXPIRED]" if days < 0 else ("[EXPIRING]" if days <= 3 else "OK")
        print(f"{r[0]:<8} {r[1]:<22} {r[2]:<8.2f} {r[3]:<8} {r[4]} {status}")
    print("0. Back")
    while True:
        choice = input("Select: ").strip()
        if choice == '0':
            break
        print("\n[ERROR] Invalid input! Type 0 to go back.")


def display_low_stock_alerts():
    print("\n--- LOW STOCK (<= 5) ---")
    found = False
    for r in inventory_records:
        if r[3] <= 5:
            print(f"ID {r[0]} | {r[1]} | Stock: {r[3]} [REORDER]")
            found = True
    if not found: print("All items are well-stocked.")
    print("0. Back")
    while True:
        choice = input("Select: ").strip()
        if choice == '0':
            break
        print("\n[ERROR] Invalid input! Type 0 to go back.")


